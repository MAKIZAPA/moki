#!/usr/bin/env python3
import os
import sys
import re
import urllib.request
import urllib.parse
import json
import xml.etree.ElementTree as ET
import concurrent.futures

CACHE_DIR = os.path.expanduser("~/.cache/moki/torrents")
os.makedirs(CACHE_DIR, exist_ok=True)

def bdecode(data):
    def decode_item(idx):
        b = data[idx:idx+1]
        if b == b'i':
            idx += 1
            end = data.find(b'e', idx)
            return int(data[idx:end]), end + 1
        elif b == b'l':
            idx += 1
            res = []
            while data[idx:idx+1] != b'e':
                item, idx = decode_item(idx)
                res.append(item)
            return res, idx + 1
        elif b == b'd':
            idx += 1
            res = {}
            while data[idx:idx+1] != b'e':
                k_bytes, idx = decode_item(idx)
                v, idx = decode_item(idx)
                k = k_bytes.decode('utf-8', 'replace') if isinstance(k_bytes, bytes) else str(k_bytes)
                res[k] = v
            return res, idx + 1
        elif b.isdigit():
            colon = data.find(b':', idx)
            length = int(data[idx:colon])
            start = colon + 1
            return data[start:start+length], start + length
        raise ValueError(f'Invalid bencode marker at index {idx}')
    res, _ = decode_item(0)
    return res

def format_bytes(num_bytes):
    if num_bytes >= 1024**3:
        return f"{num_bytes / (1024**3):.2f} GiB"
    elif num_bytes >= 1024**2:
        return f"{num_bytes / (1024**2):.1f} MiB"
    elif num_bytes >= 1024:
        return f"{num_bytes / 1024:.0f} KiB"
    return f"{num_bytes} B"

def search_nyaa_html(query, cat="1_0"):
    url = f"https://nyaa.si/?f=0&c={cat}&q={urllib.parse.quote(query)}&s=seeders&o=desc"
    req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0 (X11; Linux x86_64)"})
    try:
        with urllib.request.urlopen(req, timeout=6) as resp:
            html = resp.read().decode("utf-8", "replace")
            rows = re.findall(r'<tr class="(?:default|success|danger)">(.*?)</tr>', html, re.DOTALL)
            results = []
            for r in rows:
                tm = re.search(r'<a href="/view/\d+"[^>]*title="([^"]+)"', r) or re.search(r'<a href="/view/\d+"[^>]*>([^<]+)</a>', r)
                sm = re.search(r'<td class="text-center"[^>]*>(\d+)</td>', r)
                szm = re.search(r'<td class="text-center">([\d\.]+\s*(?:GiB|MiB|KiB))</td>', r)
                torm = re.search(r'<a href="(/download/\d+\.torrent)"', r)
                magm = re.search(r'<a href="(magnet:\?[^"]+)"', r)
                if tm and (torm or magm):
                    t = tm.group(1).strip()
                    s = int(sm.group(1)) if sm else 0
                    sz = szm.group(1).strip() if szm else "0"
                    tor = "https://nyaa.si" + torm.group(1) if torm else ""
                    mag = magm.group(1).replace("&amp;", "&") if magm else ""
                    results.append({
                        "title": t,
                        "seeders": s,
                        "size": sz,
                        "torrent_url": tor,
                        "link": tor or mag,
                        "magnet": mag
                    })
            return results
    except Exception:
        return []

def find_ep_match(fname, target_ep, target_season=None):
    base = fname.split('/')[-1]
    if not base.lower().endswith(('.mkv', '.mp4', '.avi', '.webm')):
        return False
    # Excluir temas de apertura/cierre, canciones, trailers, samples y extras
    if re.search(r'\b(ncop\d*|nced\d*|op\d*|ed\d*|ost|sample|trailer|extras?|preview|menu)\b', base, re.IGNORECASE):
        return False

    # Si se especificó temporada, verificar si el path o nombre contradice la temporada
    if target_season is not None:
        m_s = re.search(r'\bS0*(\d{1,2})(?:E\d+|\b)', fname, re.IGNORECASE) or re.search(r'\b(?:season|temporada)\s*0*(\d{1,2})\b', fname, re.IGNORECASE)
        if m_s:
            s_found = int(m_s.group(1))
            if s_found != target_season:
                return False

    cleaned = re.sub(r'^\[.*?\]\s*', '', base)

    # 1. Número absoluto de episodio entre paréntesis: (005) o (Ep 05) o (170)
    m_abs = re.search(r'\((?:ep\.?\s*)?0*(\d{1,4})\)', cleaned, re.IGNORECASE)
    if m_abs:
        return int(m_abs.group(1)) == target_ep

    # 2. S01E05, S1E05
    m = re.search(r'\bS\d+E0*(\d{1,4})\b', cleaned, re.IGNORECASE)
    if m:
        return int(m.group(1)) == target_ep

    # 3. Episode 05, Ep 05, Cap 05
    m = re.search(r'\b(?:episode|ep|cap[íi]tulo|cap)\.?\s*0*(\d{1,4})\b', cleaned, re.IGNORECASE)
    if m:
        return int(m.group(1)) == target_ep

    # 4. ' - 005 ' o ' - 05 '
    m = re.search(r'[-_]\s*0*(\d{1,4})(?:\s|v\d|\.|\_|\-|\[|\(|$)', cleaned)
    if m:
        return int(m.group(1)) == target_ep

    # 5. Número aislado que no sea resolución ni bitrate
    m = re.search(r'\b0*(\d{1,4})\b(?!\s*(?:p|bit|fps|k|mb|gb))', cleaned)
    if m:
        return int(m.group(1)) == target_ep

    return False

def inspect_batch(cand, target_ep, target_season=None):
    tor_url = cand.get("torrent_url") or cand.get("link", "")
    if not tor_url or not tor_url.startswith("http"):
        return None
    tor_id = tor_url.split("/")[-1]
    if not tor_id.endswith(".torrent"):
        tor_id += ".torrent"
    cache_path = os.path.join(CACHE_DIR, tor_id)
    raw_data = None
    if os.path.exists(cache_path):
        try:
            with open(cache_path, "rb") as f:
                raw_data = f.read()
        except Exception:
            raw_data = None
    if not raw_data:
        try:
            req = urllib.request.Request(tor_url, headers={"User-Agent": "Mozilla/5.0 (X11; Linux x86_64)"})
            with urllib.request.urlopen(req, timeout=6) as resp:
                raw_data = resp.read()
            with open(cache_path, "wb") as f:
                f.write(raw_data)
        except Exception:
            return None

    try:
        meta = bdecode(raw_data)
        info = meta.get("info", {})
        files = info.get("files")
        if not files:
            # Single file torrent
            fname = info.get("name", b"").decode("utf-8", "replace")
            if target_ep is None or find_ep_match(fname, target_ep, target_season):
                f_len = info.get("length", 0)
                return {
                    "matched_file": fname,
                    "file_idx": None,
                    "file_bytes": f_len,
                    "file_size_str": format_bytes(f_len),
                    "cache_path": cache_path
                }
            return None

        # Multi-file batch torrent
        for idx, f in enumerate(files):
            parts = [p.decode("utf-8", "replace") if isinstance(p, bytes) else str(p) for p in f.get("path", [])]
            full_path = "/".join(parts) if parts else ""
            if target_ep is not None and find_ep_match(full_path, target_ep, target_season):
                f_len = f.get("length", 0)
                return {
                    "matched_file": full_path,
                    "file_idx": idx,
                    "file_bytes": f_len,
                    "file_size_str": format_bytes(f_len),
                    "cache_path": cache_path
                }
    except Exception:
        return None
    return None

def get_anime_meta(anime_name, season=None):
    clean_title = anime_name.strip().title()
    poster = ""
    mal_id = 0

    search_term = anime_name
    if season and season > 1:
        search_term = f"{anime_name} Season {season}"

    try:
        query = '''
        query ($search: String) {
            Media(search: $search, type: ANIME) {
                idMal
                title { romaji english }
                coverImage { extraLarge large }
            }
        }
        '''
        payload = json.dumps({'query': query, 'variables': {'search': search_term}}).encode('utf-8')
        req = urllib.request.Request(
            'https://graphql.anilist.co',
            data=payload,
            headers={'Content-Type': 'application/json', 'User-Agent': 'Mozilla/5.0'}
        )
        with urllib.request.urlopen(req, timeout=4) as resp:
            data = json.loads(resp.read().decode('utf-8'))
            media = data.get("data", {}).get("Media")
            if media:
                mal_id = media.get("idMal") or 0
                titles = media.get("title", {})
                canonical = titles.get("romaji") or titles.get("english")
                if canonical:
                    clean_title = canonical
                images = media.get("coverImage", {})
                poster = images.get("extraLarge") or images.get("large") or ""
    except Exception:
        pass

    if not poster and search_term != anime_name:
        try:
            payload = json.dumps({'query': query, 'variables': {'search': anime_name}}).encode('utf-8')
            req = urllib.request.Request(
                'https://graphql.anilist.co',
                data=payload,
                headers={'Content-Type': 'application/json', 'User-Agent': 'Mozilla/5.0'}
            )
            with urllib.request.urlopen(req, timeout=4) as resp:
                data = json.loads(resp.read().decode('utf-8'))
                media = data.get("data", {}).get("Media")
                if media:
                    mal_id = media.get("idMal") or 0
                    titles = media.get("title", {})
                    canonical = titles.get("romaji") or titles.get("english")
                    if canonical:
                        clean_title = canonical
                    images = media.get("coverImage", {})
                    poster = images.get("extraLarge") or images.get("large") or ""
        except Exception:
            pass

    # 2. Fallback a Kitsu si no se obtuvo póster o información
    if not poster:
        try:
            url = f"https://kitsu.io/api/edge/anime?filter[text]={urllib.parse.quote(search_term)}&page[limit]=1"
            req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
            with urllib.request.urlopen(req, timeout=3) as resp:
                data = json.loads(resp.read())
                if data.get("data") and len(data["data"]) > 0:
                    attr = data["data"][0]["attributes"]
                    canonical = attr.get("canonicalTitle")
                    if canonical:
                        clean_title = canonical.title() if canonical.isupper() else canonical
                    poster = attr.get("posterImage", {}).get("medium", "")
        except Exception:
            pass

    return clean_title, poster, mal_id

def log(msg="", end="\n"):
    sys.stderr.write(f"{msg}{end}")
    sys.stderr.flush()

def select_with_fzf(items_text, prompt="🔎 Seleccionar: ", header=""):
    import shutil
    import subprocess
    if not shutil.which("fzf"):
        return None, False
    try:
        cmd = [
            "fzf",
            "--ansi",
            "--height=45%",
            "--layout=reverse",
            "--border",
            f"--prompt={prompt}",
            "--cycle"
        ]
        if header:
            cmd.append(f"--header={header}")
        p = subprocess.Popen(
            cmd,
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            text=True
        )
        out, _ = p.communicate(input="\n".join(items_text))
        if p.returncode == 0 and out.strip():
            m = re.search(r"\[\s*(\d+)\s*\]", out)
            if m:
                return int(m.group(1)) - 1, True
        elif p.returncode in (1, 130):
            return None, True
    except Exception:
        pass
    return None, False

def fetch_nyaa(query, category="0_0"):
    url = f"https://nyaa.si/?page=rss&q={urllib.parse.quote(query)}&c={category}&f=0"
    req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0 (X11; Linux x86_64)"})
    try:
        with urllib.request.urlopen(req, timeout=8) as resp:
            root = ET.fromstring(resp.read())
            items = []
            channel = root.find("channel")
            if channel is None:
                return []
            for item in channel.findall("item"):
                title = item.findtext("title", "")
                link = item.findtext("link", "")
                size = item.findtext("{https://nyaa.si/xmlns/nyaa}size", "N/A")
                seeders_text = item.findtext("{https://nyaa.si/xmlns/nyaa}seeders", "0")
                try:
                    seeders = int(seeders_text)
                except ValueError:
                    seeders = 0
                items.append({
                    "title": title,
                    "link": link,
                    "torrent_url": link,
                    "size": size,
                    "seeders": seeders
                })
            return items
    except Exception:
        return []

def extract_group(raw_title):
    m1 = re.match(r"^\[(.*?)\]", raw_title)
    if m1:
        return m1.group(1).strip()
    m2 = re.search(r"-([A-Za-z0-9_]+)(?:\s*\(.*?\))?$", raw_title)
    if m2:
        return m2.group(1).strip()
    return ""

def is_french(title):
    low = title.lower()
    # Si contiene explícitamente latino o español, no descartar
    if any(k in low for k in ["latino", "español", "espanol", "castellano"]):
        return False
    # Releases francesas que suelen causar audios mudos (Audio Description) o doblaje francés
    return bool(re.search(r"\b(vostfr|vf|french|subfrench|truefrench)\b|multi[\s\.]ad|-kaf\b|tsundere-raws", low))

def classify_audio(title):
    low = title.lower()
    # 1. Castellano / España específico
    if any(k in low for k in ["castellano", "españa", "espana"]) and not any(k in low for k in ["latino", "audio latino"]):
        return "ESP_ESP"

    # 2. Doblaje Latino / Multi-Audio con pista en español / Fansub dedicado
    es_lat_keywords = [
        "latino", "audio latino", "audio_latino", "doblaje", "doblajes",
        "puya", "puyasubs", "hispamux", "kakumei", "kashikoi", "sub_esp", "sub esp", "sub-esp",
        "spa-la", "multi-audio", "multi audio"
    ]
    if (any(k in low for k in es_lat_keywords) or 
        re.search(r"(\[|\()(lat|esp|spa|spa-la|spa-es)(\]|\))", low) or 
        "español" in low or "espanol" in low):
        return "LATINO"
    
    return "GLOBAL"

def parse_ep_from_title(title):
    # Eliminar tags iniciales entre corchetes para no confundir números de fansubs
    cleaned = re.sub(r"^\[.*?\]\s*", "", title)
    # 1. Patrones estándares: S01E10, S1E10
    m = re.search(r"\bS\d+E(\d{1,4})\b", cleaned, re.IGNORECASE)
    if m: return int(m.group(1))
    # 2. E10
    m = re.search(r"\bE(\d{1,4})\b", cleaned, re.IGNORECASE)
    if m: return int(m.group(1))
    # 3. Formato ' - 10 ' o ' - 10[' o ' - 10('
    m = re.search(r"\s+-\s+(\d{1,4})(?:\s+|$|\[|\()", cleaned)
    if m: return int(m.group(1))
    # 4. Formato 'Capítulo 10', 'Cap 10', 'Ep 10'
    m = re.search(r"\b(?:cap[íi]tulo|cap|episodio|ep)\.?\s*(\d{1,4})\b", cleaned, re.IGNORECASE)
    if m: return int(m.group(1))
    # 5. Número aislado entre espacios que no sea resolución (1080p, 720p, etc.) o bitrate
    m = re.search(r"\s+(\d{1,3})\s+(?!(?:p|k|bit|mb|gb|fps|hz)\b)", cleaned, re.IGNORECASE)
    if m: return int(m.group(1))
    return None

def parse_season_from_title(title: str):
    m = re.search(r'\bS0*(\d{1,2})(?:E\d+|\b)', title, re.IGNORECASE)
    if m:
        return int(m.group(1))
    m = re.search(r'\b(?:season|temporada)\s*0*(\d{1,2})\b', title, re.IGNORECASE)
    if m:
        return int(m.group(1))
    m = re.search(r'\b(\d{1,2})(?:nd|rd|th|st)\s+season\b', title, re.IGNORECASE)
    if m:
        return int(m.group(1))
    if re.search(r'\bIV\b', title): return 4
    if re.search(r'\bIII\b', title): return 3
    if re.search(r'\bII\b', title): return 2
    return None

def parse_anime_query(args):
    if isinstance(args, str):
        args_list = args.split()
        raw_str = args.strip()
    else:
        args_list = list(args)
        raw_str = " ".join(args_list).strip()

    season = None
    ep = None

    filtered_args = []
    i = 0
    while i < len(args_list):
        arg = args_list[i]
        if arg in ("-s", "--season", "-t", "--temporada") and i + 1 < len(args_list) and args_list[i+1].isdigit():
            season = int(args_list[i+1])
            i += 2
        elif arg in ("-e", "--episode", "-c", "--capitulo") and i + 1 < len(args_list) and args_list[i+1].isdigit():
            ep = int(args_list[i+1])
            i += 2
        else:
            filtered_args.append(arg)
            i += 1

    clean_str = " ".join(filtered_args).strip()

    # 1. Patrón S02E05
    m_se = re.search(r"^(.*?)[.\s_-]+S0*(\d{1,2})[.\s_-]*E0*(\d{1,4})\b", clean_str, re.IGNORECASE)
    if m_se and m_se.group(1).strip():
        name = m_se.group(1).replace(".", " ").replace("_", " ").strip()
        if season is None: season = int(m_se.group(2))
        if ep is None: ep = int(m_se.group(3))
        return name, season, ep

    # 2. Dos números al final: "Mushoku Tensei 2 5"
    m_2num = re.search(r"^(.*?)\s+(\d{1,2})\s+(\d{1,4})\s*$", clean_str)
    if m_2num and m_2num.group(1).strip():
        name = m_2num.group(1).strip()
        if season is None: season = int(m_2num.group(2))
        if ep is None: ep = int(m_2num.group(3))
        return name, season, ep

    # 3. Temporada explícita en texto: "Mushoku Tensei Season 2", "Mushoku Tensei S2"
    m_s = re.search(r"^(.*?)\s+(?:season|temporada|temp|s|t)\s*0*(\d{1,2})(?:\s+(?:ep|cap|episodio|capitulo|e)?\s*0*(\d{1,4}))?\s*$", clean_str, re.IGNORECASE)
    if m_s and m_s.group(1).strip():
        name = m_s.group(1).strip()
        if season is None: season = int(m_s.group(2))
        if ep is None and m_s.group(3): ep = int(m_s.group(3))
        return name, season, ep

    # 4. Episodio explícito al final: "Dandadan ep 5", "Dandadan cap 1"
    m_ep = re.search(r"^(.*?)(?:\s+(?:cap[íi]tulo|cap|ep|episodio|e)\s*0*(\d{1,4}))\s*$", clean_str, re.IGNORECASE)
    if m_ep and m_ep.group(1).strip():
        name = m_ep.group(1).strip()
        if ep is None: ep = int(m_ep.group(2))
        sub_name, sub_s, _ = parse_anime_query(name)
        if sub_s is not None:
            return sub_name, sub_s, ep
        return name, season, ep

    # 4.5. Temporada en números romanos: "Mushoku Tensei II", "Mushoku Tensei II 3"
    m_roman = re.search(r"^(.*?)\s+\b(IV|III|II|V)\b(?:\s+(?:ep|cap|episodio|capitulo|e)?\s*0*(\d{1,4}))?\s*$", clean_str, re.IGNORECASE)
    if m_roman and m_roman.group(1).strip():
        name = m_roman.group(1).strip()
        roman_map = {"ii": 2, "iii": 3, "iv": 4, "v": 5}
        if season is None:
            season = roman_map.get(m_roman.group(2).lower())
        if ep is None and m_roman.group(3):
            ep = int(m_roman.group(3))
        return name, season, ep

    # 5. Número simple al final
    m_num = re.search(r"^(.*?)\s+0*(\d{1,4})\s*$", clean_str)
    if m_num and m_num.group(1).strip():
        num = int(m_num.group(2))
        cand_name = m_num.group(1).strip()
        sub_name, sub_s, _ = parse_anime_query(cand_name)
        if sub_s is not None:
            return sub_name, sub_s, num
        return cand_name, season, num

    return clean_str, season, ep

def main():
    season = None
    ep = None

    if len(sys.argv) < 2:
        log("\033[1;33m🔍 Nombre del anime: \033[0m", end="")
        raw_name = sys.stdin.readline().strip()
        if not raw_name:
            log("\033[0;31mNo se ingresó ningún término de búsqueda.\033[0m")
            sys.exit(1)

        name, season, ep = parse_anime_query(raw_name)

        if season is None:
            log("\033[1;33m📅 Temporada (opcional, ej. 1, 2 o Enter para todas): \033[0m", end="")
            s_input = sys.stdin.readline().strip()
            if s_input.isdigit():
                season = int(s_input)

        if ep is None:
            log("\033[1;33m🔢 Capítulo (opcional, ej. 1, 05 o Enter para todos): \033[0m", end="")
            ep_input = sys.stdin.readline().strip()
            if ep_input.isdigit():
                ep = int(ep_input)
    else:
        full_query = " ".join(sys.argv[1:]).strip()
        name, season, ep = parse_anime_query(full_query)

    if not name:
        log("\033[0;31mNombre de anime no válido.\033[0m")
        sys.exit(1)

    ROMAN_MAP = {1: "I", 2: "II", 3: "III", 4: "IV", 5: "V"}
    s_roman = ROMAN_MAP.get(season, "") if season else ""

    queries = []
    if season is not None and ep is not None:
        s_pad = f"{season:02d}"
        ep_pad = f"{ep:02d}"
        log(f"\n\033[0;36m🔎 Buscando '{name}' Temporada {season} Capítulo {ep_pad} (Español / Latino)...\033[0m")
        queries = [
            (f"{name} S{s_pad}E{ep_pad}", "0_0"),
            (f"{name} Season {season} {ep_pad}", "0_0"),
            (f"{name} S{season} {ep_pad}", "0_0"),
            (f"{name} S{s_pad} {ep_pad} Latino", "0_0"),
            (f"{name} S{s_pad} {ep_pad} Español", "0_0"),
            (f"Puya {name} S{season} {ep_pad}", "0_0"),
            (f"{name} S{s_pad} Batch", "0_0"),
            (f"{name} Season {season} Batch", "0_0"),
            (f"{name} S{s_pad}", "0_0"),
            (f"{name} Season {season}", "0_0")
        ]
        if s_roman and season > 1:
            queries.insert(3, (f"{name} {s_roman} {ep_pad}", "0_0"))
            queries.insert(6, (f"Puya {name} {s_roman} {ep_pad}", "0_0"))
            queries.append((f"{name} {s_roman}", "0_0"))
    elif season is not None:
        s_pad = f"{season:02d}"
        log(f"\n\033[0;36m🔎 Buscando '{name}' Temporada {season} en Nyaa (Español / Latino)...\033[0m")
        queries = [
            (f"{name} S{s_pad} Latino", "0_0"),
            (f"{name} S{s_pad} Español", "0_0"),
            (f"{name} Season {season} Latino", "0_0"),
            (f"{name} Season {season} Español", "0_0"),
            (f"Puya {name} S{season}", "0_0"),
            (f"{name} S{s_pad}", "0_0"),
            (f"{name} Season {season}", "0_0"),
            (f"{name} S{season}", "0_0"),
            (f"{name} S{s_pad} Batch", "0_0"),
            (f"{name} Season {season} Batch", "0_0")
        ]
        if s_roman and season > 1:
            queries.insert(4, (f"Puya {name} {s_roman}", "0_0"))
            queries.insert(5, (f"{name} {s_roman}", "0_0"))
    elif ep is not None:
        ep_pad = f"{ep:02d}"
        ep_num = str(ep)
        log(f"\n\033[0;36m🔎 Buscando '{name}' Capítulo {ep_pad} (Español / Latino)...\033[0m")
        queries = [
            (f"{name} S01E{ep_pad}", "0_0"),
            (f"{name} {ep_pad} Latino", "0_0"),
            (f"{name} {ep_pad} Español", "0_0"),
            (f"{name} E{ep_pad} Latino", "0_0"),
            (f"Puya {name} {ep_pad}", "0_0"),
            (f"{name} - {ep_pad}", "0_0"),
            (f"{name} {ep_pad}", "0_0"),
            (f"{name} {ep_pad}", "1_3"),
            (f"{name} {ep_num}", "0_0"),
            (f"{name} Latino", "0_0")
        ]
    else:
        log(f"\n\033[0;36m🔎 Buscando '{name}' en Nyaa (Español / Latino)...\033[0m")
        queries = [
            (f"{name} Latino", "0_0"),
            (f"{name} Español", "0_0"),
            (f"Puya {name}", "0_0"),
            (name, "1_3"),
            (name, "0_0")
        ]

    seen = set()
    spanish_results = []
    other_results = []
    raw_candidates = []

    # 1. Consultas RSS normales de Nyaa
    for q_str, cat in queries:
        items = fetch_nyaa(q_str, cat)
        for item in items:
            raw_candidates.append(item)

    # 2. Consulta HTML ordenada por semillas
    html_search_term = f"{name} S{season:02d}" if season else name
    html_items = search_nyaa_html(html_search_term, "1_0")
    for item in html_items:
        raw_candidates.append(item)
    if season and season > 1:
        for item in search_nyaa_html(f"{name} Season {season}", "1_0"):
            raw_candidates.append(item)

    batch_candidates = []
    for item in raw_candidates:
        u_key = item.get("torrent_url") or item.get("link") or item["title"]
        if u_key in seen:
            continue
        seen.add(u_key)

        if is_french(item["title"]):
            continue

        low_title = item["title"].lower()
        size_str = item.get("size", "").lower()
        m_sz = re.search(r"[\d\.]+", size_str)
        sz_val = float(m_sz.group(0)) if m_sz else 0.0

        is_pack = (
            any(k in low_title for k in ["batch", "seasons", "season", "complete", "pack", "01-", "01 ~", "001-", "001 ~", "vol.", "vols."]) or
            ("gib" in size_str and not any(k in size_str for k in ["kib", "mib"]) and sz_val >= 3.0)
        )

        # Filtrar por temporada si se especificó
        if season is not None:
            parsed_s = parse_season_from_title(item["title"])
            if parsed_s is not None and parsed_s != season:
                continue
            if season > 1 and parsed_s is None:
                if not any(k in low_title for k in [f"s{season}", f"s{season:02d}", f"season {season}", f"season{season}", f"t{season}", s_roman.lower() if s_roman else "___"]):
                    continue

        if ep is not None:
            if is_pack:
                batch_candidates.append(item)
                continue
            parsed_ep = parse_ep_from_title(item["title"])
            if parsed_ep is not None and parsed_ep != ep:
                continue

        cls = classify_audio(item["title"])
        item["cls"] = cls
        if cls in ("LATINO", "ESP_ESP"):
            spanish_results.append(item)
        else:
            other_results.append(item)

    # 3. Si se pidió un capítulo específico, inspeccionar batches de alta semilla
    if ep is not None and batch_candidates:
        batch_candidates.sort(key=lambda x: x.get("seeders", 0), reverse=True)
        top_batches = batch_candidates[:6]

        with concurrent.futures.ThreadPoolExecutor(max_workers=5) as executor:
            future_to_cand = {executor.submit(inspect_batch, cand, ep, season): cand for cand in top_batches}
            for fut in concurrent.futures.as_completed(future_to_cand):
                cand = future_to_cand[fut]
                try:
                    res = fut.result()
                except Exception:
                    res = None
                if res and res.get("file_idx") is not None:
                    cls = classify_audio(cand["title"])
                    batch_item = {
                        "title": f"{cand['title']} \033[1;35m[PACK ➔ Cap {ep:02d}]\033[0m",
                        "raw_title": cand["title"],
                        "link": cand.get("torrent_url") or cand["link"],
                        "torrent_url": cand.get("torrent_url", ""),
                        "magnet": cand.get("magnet", ""),
                        "cache_path": res.get("cache_path", ""),
                        "size": res["file_size_str"],
                        "seeders": cand.get("seeders", 0),
                        "file_idx": res["file_idx"],
                        "cls": cls,
                        "is_batch": True,
                        "matched_ep": ep
                    }
                    if cls in ("LATINO", "ESP_ESP"):
                        spanish_results.append(batch_item)
                    else:
                        other_results.append(batch_item)

    spanish_results.sort(key=lambda x: x["seeders"], reverse=True)
    other_results.sort(key=lambda x: x["seeders"], reverse=True)

    final_list = (spanish_results + other_results)[:15]

    if not final_list:
        desc_ep = f" temporada {season}" if season else ""
        desc_ep += f" capítulo {ep}" if ep else ""
        log(f"\033[0;31mNo se encontraron resultados para '{name}'{desc_ep}.\033[0m")
        sys.exit(1)

    header = name
    if season and ep:
        header = f"{name} - T{season:02d}E{ep:02d}"
    elif ep:
        header = f"{name} - Cap {ep}"
    elif season:
        header = f"{name} - Temporada {season}"

    fzf_lines = []
    for i, item in enumerate(final_list, 1):
        color_seed = "\033[0;32m" if item["seeders"] > 5 else "\033[1;33m" if item["seeders"] > 0 else "\033[0;31m"
        cls = item.get("cls", "GLOBAL")
        if cls == "LATINO":
            tag = "\033[1;32m[ESPAÑOL/LATINO]\033[0m"
        elif cls == "ESP_ESP":
            tag = "\033[1;33m[ESPAÑOL (ESPAÑA)]\033[0m"
        else:
            tag = "\033[0;34m[GLOBAL]\033[0m"
        line = f"\033[1;36m[{i:2d}]\033[0m {tag} {color_seed}🌱 {item['seeders']:3d} seeds\033[0m  📦 \033[0;35m{item['size']:>9s}\033[0m  \033[1;37m{item['title']}\033[0m"
        fzf_lines.append(line)

    pref_group = os.environ.get("PREF_GROUP", "").strip().lower()
    selected = None

    if pref_group:
        for item in final_list:
            if pref_group in item["title"].lower() and item["seeders"] > 0:
                if ep is not None:
                    if item.get("is_batch"):
                        if item.get("matched_ep") != ep:
                            continue
                    else:
                        p_ep = parse_ep_from_title(item["title"])
                        if p_ep is not None and p_ep != ep:
                            continue
                log(f"\n\033[1;32m🎯 ¡Coincidencia automática encontrada del grupo '{pref_group.upper()}'!\033[0m")
                log(f"\033[0;36m   ➔ {item['title']} (🌱 {item['seeders']} seeds)\033[0m\n")
                selected = item
                break

    if not selected:
        choice_idx, used_fzf = select_with_fzf(
            fzf_lines,
            prompt="🔎 Filtrar versión: ",
            header=f"Resultados: {header} | ↑↓ Moverse | Escribe para buscar (ej. latino, 1080p, puya) | Enter = Ver | Esc = Salir"
        )

        if used_fzf:
            if choice_idx is None:
                sys.exit(0)
            selected = final_list[choice_idx]
        else:
            log("\n\033[1;32m═══════════════════════════════════════════════════════════════════════\033[0m")
            log(f"\033[1;37m Resultados para: \033[1;33m{header}\033[0m")
            log("\033[1;32m═══════════════════════════════════════════════════════════════════════\033[0m\n")
            for line in fzf_lines:
                log(f"  {line}\n")
            log("\033[1;32m═══════════════════════════════════════════════════════════════════════\033[0m")

            while True:
                log("\033[1;33mSelecciona el número a reproducir (o 'q' para salir): \033[0m", end="")
                choice = sys.stdin.readline().strip()
                if choice.lower() in ('q', 'quit', 'exit', ''):
                    sys.exit(0)
                if choice.isdigit() and 1 <= int(choice) <= len(final_list):
                    selected = final_list[int(choice) - 1]
                    break
                log("\033[0;31mOpción no válida. Ingresa un número de la lista.\033[0m")

    if selected:
        size_gb = 0.0
        m_sz = re.search(r"([\d\.]+)\s*(GB|GiB|MB|MiB)", selected.get("size", ""), re.IGNORECASE)
        if m_sz:
            val = float(m_sz.group(1))
            unit = m_sz.group(2).upper()
            if "M" in unit:
                size_gb = val / 1024.0
            else:
                size_gb = val
        title_clean, poster, mal_id = get_anime_meta(name, season)
        group = extract_group(selected['title'])
        target = selected.get("cache_path") or selected.get("torrent_url") or selected["link"]
        print(f"MAGNET:{target}")
        if selected.get("file_idx") is not None:
            print(f"FILE_IDX:{selected['file_idx']}")
            print(f"FILEIDX:{selected['file_idx']}")
        if selected.get("is_batch"):
            print("IS_BATCH:1")
        print(f"SIZE_GB:{size_gb:.2f}")
        print(f"TITLE:{title_clean}")
        print(f"TYPE:anime")
        print(f"SEASON:{season if season is not None else 1}")
        print(f"EPISODE_NUM:{ep if ep is not None else 1}")
        print(f"HAS_LATINO:{1 if selected.get('cls') in ('LATINO', 'ESP_ESP') else 0}")
        print(f"MAL_ID:{mal_id}")
        print(f"GROUP:{group}")
        print(f"RELEASE_TITLE:{selected.get('raw_title', selected['title'])}")
        if season is not None and ep is not None:
            print(f"EPISODE:Temporada {season} • Episodio {ep}")
        elif ep is not None:
            print(f"EPISODE:Episodio {ep}")
        elif season is not None:
            print(f"EPISODE:Temporada {season}")
        else:
            print("EPISODE:Anime")
        if poster:
            print(f"POSTER:{poster}")
        sys.stdout.flush()

if __name__ == "__main__":
    main()
