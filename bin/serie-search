#!/usr/bin/env python3
import os
import sys
import re
import urllib.request
import urllib.parse
import json

TRACKERS = [
    "udp://tracker.opentrackr.org:1337/announce",
    "udp://9.rarbg.to:2920/announce",
    "udp://tracker.openbittorrent.com:6969/announce",
    "udp://exodus.desync.com:6969/announce",
    "udp://open.stealth.si:80/announce",
    "udp://tracker.torrent.eu.org:451/announce"
]

def log(msg="", end="\n"):
    sys.stderr.write(f"{msg}{end}")
    sys.stderr.flush()

def select_with_fzf(items_text, prompt="🔎 Seleccionar: ", header=""):
    import shutil
    import subprocess
    if not shutil.which("fzf"):
        return None, False
    try:
        cmd = [
            "fzf",
            "--ansi",
            "--height=45%",
            "--layout=reverse",
            "--border",
            f"--prompt={prompt}",
            "--cycle"
        ]
        if header:
            cmd.append(f"--header={header}")
        p = subprocess.Popen(
            cmd,
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            text=True
        )
        out, _ = p.communicate(input="\n".join(items_text))
        if p.returncode == 0 and out.strip():
            m = re.search(r"\[\s*(\d+)\s*\]", out)
            if m:
                return int(m.group(1)) - 1, True
        elif p.returncode in (1, 130):
            return None, True
    except Exception:
        pass
    return None, False

def detect_platform(text):
    t = text.upper()
    if any(k in t for k in ["HMAX", "MAX.", ".MAX", "-MAX", "HBO"]):
        return "HBO Max"
    if any(k in t for k in ["NF.", ".NF", "-NF", "NETFLIX"]):
        return "Netflix"
    if any(k in t for k in ["DSNP", "DISNEY"]):
        return "Disney+"
    if any(k in t for k in ["AMZN", "PRIME"]):
        return "Amazon Prime"
    if any(k in t for k in ["ATVP", "APPLE"]):
        return "Apple TV+"
    if "HULU" in t:
        return "Hulu"
    if any(k in t for k in ["PMTP", "PARAMOUNT"]):
        return "Paramount+"
    if any(k in t for k in ["PEAC", "PEACOCK"]):
        return "Peacock"
    if "CINECALIDAD" in t:
        return "Cinecalidad"
    if any(k in t for k in ["BLURAY", "BDRIP", "REMUX"]):
        return "BluRay"
    return ""

def search_cinemeta(q):
    prefer_movie = os.environ.get("MEDIA_PREF") == "movie" or "pelis" in sys.argv[0].lower()
    series_res = []
    movie_res = []

    # Buscar en Series
    try:
        url_s = f"https://v3-cinemeta.strem.io/catalog/series/top/search={urllib.parse.quote(q)}.json"
        req = urllib.request.Request(url_s, headers={"User-Agent": "Mozilla/5.0"})
        data = json.loads(urllib.request.urlopen(req, timeout=6).read())
        for m in data.get("metas", [])[:5]:
            year = str(m.get("year") or m.get("releaseInfo") or "").strip()
            network = str(m.get("network") or "").strip()
            poster = str(m.get("poster") or "").strip()
            series_res.append({
                "type": "series",
                "name": m.get("name"),
                "year": year,
                "network": network,
                "poster": poster,
                "id": m.get("id")
            })
    except Exception:
        pass

    # Buscar en Películas
    try:
        url_m = f"https://v3-cinemeta.strem.io/catalog/movie/top/search={urllib.parse.quote(q)}.json"
        req = urllib.request.Request(url_m, headers={"User-Agent": "Mozilla/5.0"})
        data = json.loads(urllib.request.urlopen(req, timeout=6).read())
        for m in data.get("metas", [])[:5]:
            year = str(m.get("year") or m.get("releaseInfo") or "").strip()
            network = str(m.get("network") or "").strip()
            poster = str(m.get("poster") or "").strip()
            movie_res.append({
                "type": "movie",
                "name": m.get("name"),
                "year": year,
                "network": network,
                "poster": poster,
                "id": m.get("id")
            })
    except Exception:
        pass

    if prefer_movie:
        return movie_res + series_res
    return series_res + movie_res

def is_too_large_or_remux(title, size_str):
    if "REMUX" in title.upper():
        return True
    m = re.search(r"([\d\.]+)\s*(GB|GiB|MB|MiB)", size_str, re.IGNORECASE)
    if m:
        val = float(m.group(1))
        unit = m.group(2).upper()
        if "G" in unit and val > 30.0:
            return True
    return False

def get_streams(media_type, imdb_id, season=1, episode=1):
    # Excluir screener (scr), grabaciones de cine (cam) y BluRay REMUX (brremux)
    config = "sort=quality|language=latino,spanish|qualityfilter=scr,cam,brremux"
    if media_type == "movie":
        url = f"https://torrentio.strem.fun/{config}/stream/movie/{imdb_id}.json"
    else:
        url = f"https://torrentio.strem.fun/{config}/stream/series/{imdb_id}:{season}:{episode}.json"

    req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
    try:
        data = json.loads(urllib.request.urlopen(req, timeout=8).read())
        return data.get("streams", [])
    except Exception as e:
        log(f"\033[0;31mError al consultar streams: {e}\033[0m")
        return []

def parse_stream_info(stream):
    lines = stream.get("title", "").split("\n")
    first = lines[0] if lines else "Stream"
    
    # Extraer seeds y tamaño si existen
    meta_text = " ".join(lines[1:]) if len(lines) > 1 else ""
    seeds_m = re.search(r"👤\s*(\d+)", meta_text)
    size_m = re.search(r"💾\s*([\d\.]+\s*(?:GB|MB|GiB|MiB))", meta_text)
    source_m = re.search(r"⚙️\s*([^\s\n]+)", meta_text)

    seeds = int(seeds_m.group(1)) if seeds_m else 0
    size = size_m.group(1) if size_m else "N/A"
    source = source_m.group(1) if source_m else "P2P"

    # Detectar resolución
    res = "1080p"
    if "2160p" in first.lower() or "4k" in first.lower() or "4k" in stream.get("name", "").lower():
        res = "4K"
    elif "1080p" in first.lower() or "1080p" in stream.get("name", "").lower():
        res = "1080p"
    elif "720p" in first.lower():
        res = "720p"

    # Detectar idioma de forma rigurosa para evitar falsos positivos
    full_text = (first + " " + meta_text).lower()
    has_multi_audio_text = "multi audio" in meta_text.lower() or "dual audio" in meta_text.lower()
    has_latino_flag = "🇲🇽" in meta_text
    has_spain_flag = "🇪🇸" in meta_text

    # 1. Detección certera de Audio Latino
    # Se busca palabra completa (boundary \b) para no confundir con 'Latarnie' (polaco) o 'lateral'
    is_latino = False
    if has_latino_flag or "cinecalidad" in full_text:
        is_latino = True
    elif re.search(r'\b(latino|lat|dual-lat|audio-latino)\b', full_text):
        if not re.search(r'\b(latarnie|lateral)\b', full_text):
            is_latino = True

    # 2. Detección certera de Audio Castellano / España
    is_spanish = False
    if not is_latino:
        if has_spain_flag and has_multi_audio_text:
            is_spanish = True
        elif any(k in full_text for k in ["castellano", "tri-audio", "spa-eng", "esp-eng", "wolfmax4k", "mejortorrent"]):
            is_spanish = True
        elif re.search(r'\b(spa|esp)\b', first.lower()) and has_multi_audio_text:
            is_spanish = True

    # 3. Multi-audio que contiene doblaje al español
    is_multi = False
    if not is_latino and not is_spanish:
        if "19.audio.languages" in full_text or ("multi+" in full_text and has_spain_flag):
            is_multi = True
        elif has_multi_audio_text and (has_spain_flag or "spa" in full_text):
            is_multi = True

    # 4. Únicamente subtítulos en español (audio original en inglés/coreano/etc)
    is_sub = False
    if not is_latino and not is_spanish and not is_multi:
        if has_spain_flag or "sub" in full_text or "vose" in full_text:
            is_sub = True

    lang_tag = ""
    lang_score = 0
    if is_latino:
        lang_tag = "\033[1;32m[LATINO 🇲🇽]\033[0m"
        lang_score = 4
    elif is_spanish:
        lang_tag = "\033[1;33m[ESPAÑOL 🇪🇸]\033[0m"
        lang_score = 3
    elif is_multi:
        lang_tag = "\033[1;36m[MULTI-AUDIO]\033[0m"
        lang_score = 2
    elif is_sub:
        lang_tag = "\033[0;35m[SUB ESPAÑOL 💬]\033[0m"
        lang_score = 1
    else:
        lang_tag = "\033[0;34m[ORIGINAL]\033[0m"
        lang_score = 0

    # Detectar plataforma
    platform = detect_platform(first + " " + meta_text)
    platform_tag = f"\033[1;34m[{platform}]\033[0m " if platform else ""

    return {
        "title": first,
        "res": res,
        "size": size,
        "seeds": seeds,
        "source": source,
        "lang_tag": lang_tag,
        "lang_score": lang_score,
        "platform_tag": platform_tag,
        "infoHash": stream.get("infoHash"),
        "fileIdx": stream.get("fileIdx")
    }

def main():
    raw_input_text = ""
    season_arg = None
    episode_arg = None

    if len(sys.argv) > 1:
        # Detectar si pasaron: serie "The Last of Us" 1 2 o serie "Dune"
        args = sys.argv[1:]
        if len(args) >= 3 and args[-2].isdigit() and args[-1].isdigit():
            season_arg = int(args[-2])
            episode_arg = int(args[-1])
            raw_input_text = " ".join(args[:-2])
        else:
            raw_input_text = " ".join(args)

    if not raw_input_text:
        log("\033[1;33m🔍 Nombre de la serie o película: \033[0m", end="")
        raw_input_text = sys.stdin.readline().strip()

    if not raw_input_text:
        log("\033[0;31mNo se ingresó ningún nombre.\033[0m")
        sys.exit(1)

    log(f"\n\033[0;36m🔎 Buscando '{raw_input_text}' en catálogo verificado...\033[0m")
    items = search_cinemeta(raw_input_text)

    if not items:
        log(f"\033[0;31mNo se encontraron series ni películas para '{raw_input_text}'.\033[0m")
        sys.exit(1)

    # Si hay múltiples resultados, mostrar lista con fzf o fallback
    selected_media = items[0]
    if len(items) > 1:
        fzf_titles = []
        for i, it in enumerate(items, 1):
            type_icon = "📺 Serie" if it["type"] == "series" else "🎬 Película"
            year_str = f" \033[1;33m({it['year']})\033[0m" if it["year"] else ""
            net_str = f" \033[1;35m[{it['network']}]\033[0m" if it["network"] else ""
            fzf_titles.append(f"\033[1;36m[{i}]\033[0m \033[1;37m{it['name']}\033[0m{year_str}{net_str}  \033[0;36m[{type_icon}]\033[0m")

        c_idx, used_fzf = select_with_fzf(
            fzf_titles,
            prompt="🔎 Elegir título: ",
            header="Múltiples coincidencias | ↑↓ Navega | Escribe para filtrar | Enter = Seleccionar | Esc = Salir"
        )
        if used_fzf:
            if c_idx is None:
                sys.exit(0)
            selected_media = items[c_idx]
        else:
            log("\n\033[1;32m══════════════════════════════════════════════════════════════╗\033[0m")
            log("\033[1;37m Títulos encontrados:                                         ║\033[0m")
            log("\033[1;32m══════════════════════════════════════════════════════════════╝\033[0m")
            for t_line in fzf_titles:
                log(f"  {t_line}")
            log("\n\033[1;33mSelecciona el título [1]: \033[0m", end="")
            choice = sys.stdin.readline().strip()
            if choice.isdigit() and 1 <= int(choice) <= len(items):
                selected_media = items[int(choice) - 1]

    media_type = selected_media["type"]
    imdb_id = selected_media["id"]
    media_name = selected_media["name"]

    season = 1
    episode = 1
    if media_type == "series":
        if season_arg is not None and episode_arg is not None:
            season = season_arg
            episode = episode_arg
        else:
            log(f"\n\033[1;33m📅 Temporada [1]: \033[0m", end="")
            s_inp = sys.stdin.readline().strip()
            season = int(s_inp) if s_inp.isdigit() else 1

            log(f"\033[1;33m🔢 Capítulo [1]: \033[0m", end="")
            e_inp = sys.stdin.readline().strip()
            episode = int(e_inp) if e_inp.isdigit() else 1

        log(f"\n\033[0;36m🔎 Obteniendo streams para {media_name} T{season:02d}E{episode:02d}...\033[0m")
    else:
        log(f"\n\033[0;36m🔎 Obteniendo streams para película {media_name}...\033[0m")

    raw_streams = get_streams(media_type, imdb_id, season, episode)
    if not raw_streams:
        log("\033[0;31mNo se encontraron streams disponibles con fuentes activas.\033[0m")
        sys.exit(1)

    parsed = []
    for s in raw_streams:
        if s.get("infoHash"):
            info = parse_stream_info(s)
            if not is_too_large_or_remux(info["title"], info["size"]):
                parsed.append(info)
    
    # Ordenar con prioridad: 1º Latino 🇲🇽, 2º Castellano 🇪🇸, 3º Multi-Audio, 4º Subtitulado 💬, 5º Original
    # En calidad: Prioridad absoluta a 1080p (estándar óptimo solicitado), luego 4K, luego 720p
    def sort_key(x):
        res_score = 0
        if x["res"] == "1080p":
            res_score = 2
        elif x["res"] == "4K":
            res_score = 1

        return (x.get("lang_score", 0), res_score, x["seeds"])

    parsed.sort(key=sort_key, reverse=True)
    top_streams = parsed[:25]

    header = f"{media_name} (T{season:02d}E{episode:02d})" if media_type == "series" else media_name
    fzf_stream_lines = []
    for i, s in enumerate(top_streams, 1):
        color_seed = "\033[0;32m" if s["seeds"] > 10 else "\033[1;33m" if s["seeds"] > 0 else "\033[0;31m"
        res_color = "\033[1;35m" if s["res"] == "4K" else "\033[1;36m"
        line = f"\033[1;36m[{i:2d}]\033[0m {s['lang_tag']} {res_color}[{s['res']}]\033[0m {s['platform_tag']}{color_seed}🌱 {s['seeds']:3d} seeds\033[0m  📦 \033[0;35m{s['size']:>9s}\033[0m  \033[1;37m{s['title'][:60]}\033[0m"
        fzf_stream_lines.append(line)

    c_idx, used_fzf = select_with_fzf(
        fzf_stream_lines,
        prompt="🔎 Filtrar versión/calidad: ",
        header=f"Streams: {header} | ↑↓ Moverse | Escribe (ej. latino, 1080p, 4k, bluray) | Enter = Ver | Esc = Salir"
    )

    chosen = None
    if used_fzf:
        if c_idx is None:
            sys.exit(0)
        chosen = top_streams[c_idx]
    else:
        log("\n\033[1;32m═══════════════════════════════════════════════════════════════════════\033[0m")
        log(f"\033[1;37m Streams seguros para: \033[1;33m{header}\033[0m")
        log("\033[1;32m═══════════════════════════════════════════════════════════════════════\033[0m\n")
        for line in fzf_stream_lines:
            log(f"  {line}\n")
        log("\033[1;32m═══════════════════════════════════════════════════════════════════════\033[0m")

        while True:
            log("\033[1;33mSelecciona el stream a reproducir (o 'q' para salir): \033[0m", end="")
            c = sys.stdin.readline().strip()
            if c.lower() in ('q', 'quit', 'exit', ''):
                sys.exit(0)
            if c.isdigit() and 1 <= int(c) <= len(top_streams):
                chosen = top_streams[int(c) - 1]
                break
            log("\033[0;31mOpción no válida. Ingresa un número de la lista.\033[0m")

    if chosen:
        tr_query = "".join(f"&tr={urllib.parse.quote(t)}" for t in TRACKERS)
        magnet = f"magnet:?xt=urn:btih:{chosen['infoHash']}{tr_query}"
        
        # Extraer tamaño numérico en GB para selección de buffer inteligente
        size_gb = 0.0
        m_sz = re.search(r"([\d\.]+)\s*(GB|GiB|MB|MiB)", chosen.get("size", ""), re.IGNORECASE)
        if m_sz:
            val = float(m_sz.group(1))
            unit = m_sz.group(2).upper()
            if "M" in unit:
                size_gb = val / 1024.0
            else:
                size_gb = val

        # Emitir magnet, fileIdx, tamaño y metadatos para Discord
        print(f"MAGNET:{magnet}")
        if chosen.get("fileIdx") is not None:
            print(f"FILEIDX:{chosen['fileIdx']}")
        print(f"SIZE_GB:{size_gb:.2f}")
        print(f"SIZE_STR:{chosen.get('size', 'N/A')}")
        print(f"TITLE:{selected_media['name']}")
        print(f"TYPE:{media_type}")
        print(f"SEASON:{season}")
        print(f"EPISODE_NUM:{episode}")
        if media_type == "series":
            print(f"EPISODE:Temporada {season} • Episodio {episode}")
        else:
            print("EPISODE:Película")
        if selected_media.get("poster"):
            print(f"POSTER:{selected_media['poster']}")
        sys.stdout.flush()

if __name__ == "__main__":
    main()
