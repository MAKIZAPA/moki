#!/usr/bin/env bash
# ==========================================================
# CLI Series & Películas Streamer (Cinemeta + Torrentio + mpv)
# ==========================================================

GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BOLD='\033[1m'
NC='\033[0m' # No Color

STREAM_BIN="webtorrent"
SEARCH_SCRIPT="$HOME/.local/bin/serie-search"
VOICE_SCRIPT="$HOME/.local/bin/anime-voice"

# Limpieza preventiva y de cierre (para que no quede NINGÚN archivo residual)
cleanup() {
    rm -rf /tmp/webtorrent* /tmp/torrent-stream* /tmp/current_media.json /tmp/latino_stream_ready.json /tmp/latino_audio.aac "$HOME/.cache/webtorrent" 2>/dev/null
}
trap cleanup EXIT INT TERM HUP QUIT

# Función para reproducir enlace
play_stream() {
    local target="$1"
    local file_idx="$2"
    local size_gb="${3:-0}"
    local title="$4"
    local episode="$5"
    local poster="$6"
    local media_type="${7:-series}"
    local season="${8:-1}"
    local ep_num="${9:-1}"
    local start_time="${10:-${RESUME_START_TIME:-0}}"
    local has_latino="${11:-0}"
    local imdb_id="${12:-}"
    local group="${13:-}"
    local res="${14:-1080p}"
    local lang_score="${15:-0}"
    # Resetear RESUME_START_TIME globalmente para que cualquier salto maratón posterior arranque en 00:00
    export RESUME_START_TIME=0
    local select_flag=""
    local out_dir="/tmp/webtorrent"

    # Limpieza de carpetas de streaming previas y estado de audio previo
    rm -rf /tmp/webtorrent* /tmp/torrent-stream* /tmp/latino_stream_ready.json /tmp/latino_audio.aac "$HOME/.cache/webtorrent" 2>/dev/null

    # Pre-carga automática en segundo plano de Audio Latino Web en memoria RAM si se conoce el título
    if [ -n "$title" ] && [ "$has_latino" != "1" ]; then
        echo -e "${CYAN}:: Iniciando pre-carga de Audio Latino Web en segundo plano...${NC}"
        ("$HOME/.local/bin/latino-audio-resolver" "$title" "$season" "$ep_num" --prefetch >/dev/null 2>&1 &)
    fi

    # Escribir metadatos limpios, póster y tiempo de inicio para Discord y MPV
    if [ -n "$title" ]; then
        cat <<EOF > /tmp/current_media.json
{
  "title": "$title",
  "type": "$media_type",
  "season": $season,
  "episode": "$episode",
  "episode_num": $ep_num,
  "start_time": $start_time,
  "poster": "$poster",
  "magnet": "$target",
  "file_idx": "$file_idx",
  "size_gb": "$size_gb",
  "imdb_id": "$imdb_id",
  "group": "$group",
  "res": "$res",
  "has_latino": $has_latino,
  "lang_score": $lang_score
}
EOF
    fi

    # Buffer inteligente:
    # Si pesa >= 6 GB, usamos SSD (~/.cache/webtorrent) para evitar desbordar los 7.8 GB de RAM (/tmp)
    # Si pesa < 6 GB, usamos RAM pura (/tmp/webtorrent) para cero desgaste de disco
    local int_size="${size_gb%%.*}"
    if [[ "$int_size" =~ ^[0-9]+$ ]] && [ "$int_size" -ge 6 ]; then
        if [ "$int_size" -gt 30 ]; then
            echo -e "${RED}[!] El archivo (${size_gb} GB) supera el tope máximo de seguridad de 30 GB configurado.${NC}"
            echo -e "${YELLOW}Selecciona una opción más ligera de la lista para no saturar tu disco.${NC}"
            return 1
        fi
        out_dir="$HOME/.cache/webtorrent"
        mkdir -p "$out_dir"
        echo -e "${YELLOW}:: Archivo grande (~${int_size} GB): Usando buffer temporal en disco (~/.cache/webtorrent).${NC}"
        echo -e "${YELLOW}   Se eliminará automáticamente al 100% apenas termines de ver.${NC}"
    else
        echo -e "${GREEN}:: Archivo optimizado: Buffer 100% en memoria RAM (/tmp). Cero desgaste en tu SSD.${NC}"
    fi

    if [ -n "$file_idx" ]; then
        select_flag="-s $file_idx"
    fi

    echo -e "\n${GREEN}:: Conectando a enjambre verificado y cargando stream en mpv...${NC}"
    echo -e "${YELLOW}Atajos: [L] Inyectar Audio Latino Web | '#' cambia audio | [Alt+z/x] Sincronía | 'j' subs | 'q' cerrar${NC}\n"

    $STREAM_BIN "$target" -o "$out_dir" $select_flag --mpv

    echo -e "\n${GREEN}:: Limpieza automática: Eliminando buffer y archivos temporales... ¡Listo!${NC}"
    rm -rf /tmp/webtorrent* /tmp/torrent-stream* "$HOME/.cache/webtorrent" 2>/dev/null
}

# Ejecutar búsqueda y reproducir (con bucle de Modo Maratón para series)
run_search_and_play() {
    local current_args=("$@")

    while true; do
        rm -f /tmp/marathon_next.json
        local output
        output=$("$SEARCH_SCRIPT" "${current_args[@]}")

        local magnet
        local file_idx
        local size_gb
        local title
        local episode
        local poster
        local media_type
        local season
        local ep_num
        local has_latino
        local imdb_id
        local group
        local res
        local lang_score

        magnet=$(echo "$output" | grep "^MAGNET:" | head -n1 | cut -d':' -f2-)
        file_idx=$(echo "$output" | grep "^FILEIDX:" | head -n1 | cut -d':' -f2-)
        size_gb=$(echo "$output" | grep "^SIZE_GB:" | head -n1 | cut -d':' -f2-)
        title=$(echo "$output" | grep "^TITLE:" | head -n1 | cut -d':' -f2-)
        episode=$(echo "$output" | grep "^EPISODE:" | head -n1 | cut -d':' -f2-)
        media_type=$(echo "$output" | grep "^TYPE:" | head -n1 | cut -d':' -f2-)
        season=$(echo "$output" | grep "^SEASON:" | head -n1 | cut -d':' -f2-)
        ep_num=$(echo "$output" | grep "^EPISODE_NUM:" | head -n1 | cut -d':' -f2-)
        has_latino=$(echo "$output" | grep "^HAS_LATINO:" | head -n1 | cut -d':' -f2-)
        poster=$(echo "$output" | grep "^POSTER:" | head -n1 | cut -d':' -f2-)
        imdb_id=$(echo "$output" | grep "^IMDB_ID:" | head -n1 | cut -d':' -f2-)
        group=$(echo "$output" | grep "^GROUP:" | head -n1 | cut -d':' -f2-)
        res=$(echo "$output" | grep "^RES:" | head -n1 | cut -d':' -f2-)
        lang_score=$(echo "$output" | grep "^LANG_SCORE:" | head -n1 | cut -d':' -f2-)

        [ -z "$media_type" ] && media_type="series"
        [ -z "$season" ] && season=1
        [ -z "$ep_num" ] && ep_num=1
        [ -z "$has_latino" ] && has_latino=0
        [ -z "$res" ] && res="1080p"
        [ -z "$lang_score" ] && lang_score=0
        local start_time="${RESUME_START_TIME:-0}"
        export RESUME_START_TIME=0

        if [ -n "$magnet" ]; then
            play_stream "$magnet" "$file_idx" "$size_gb" "$title" "$episode" "$poster" "$media_type" "$season" "$ep_num" "$start_time" "$has_latino" "$imdb_id" "$group" "$res" "$lang_score"
        else
            break
        fi

        # Comprobar si Modo Maratón solicitó el siguiente capítulo (para series)
        if [ -f /tmp/marathon_next.json ]; then
            local next_ep
            local next_season
            local next_title
            local next_imdb
            local next_group
            local next_res
            local next_has_latino
            local next_lang_score
            next_ep=$(jq -r '.next_ep' /tmp/marathon_next.json 2>/dev/null)
            next_season=$(jq -r '.season' /tmp/marathon_next.json 2>/dev/null)
            next_title=$(jq -r '.title' /tmp/marathon_next.json 2>/dev/null)
            next_imdb=$(jq -r '.imdb_id // empty' /tmp/marathon_next.json 2>/dev/null)
            next_group=$(jq -r '.group // empty' /tmp/marathon_next.json 2>/dev/null)
            next_res=$(jq -r '.res // empty' /tmp/marathon_next.json 2>/dev/null)
            next_has_latino=$(jq -r '.has_latino // 0' /tmp/marathon_next.json 2>/dev/null)
            next_lang_score=$(jq -r '.lang_score // 0' /tmp/marathon_next.json 2>/dev/null)
            rm -f /tmp/marathon_next.json

            if [ -n "$next_ep" ] && [ "$next_ep" != "null" ]; then
                echo -e "\n${CYAN}${BOLD}╔══════════════════════════════════════════════════════════════╗${NC}"
                echo -e "${CYAN}${BOLD}║  :: MODO MARATÓN: Cargando Temporada ${next_season} Episodio ${next_ep}...  ║${NC}"
                echo -e "${CYAN}${BOLD}╚══════════════════════════════════════════════════════════════╝${NC}\n"
                export RESUME_START_TIME=0

                current_args=()
                if [ -n "$next_imdb" ]; then
                    current_args+=(--imdb "$next_imdb")
                fi
                if [ -n "$next_title" ]; then
                    current_args+=(--title "$next_title")
                fi
                current_args+=("$next_season" "$next_ep")
                if [ -n "$next_group" ]; then
                    current_args+=(--group "$next_group")
                fi
                if [ -n "$next_res" ]; then
                    current_args+=(--res "$next_res")
                fi
                if [ -n "$next_lang_score" ]; then
                    current_args+=(--lang-score "$next_lang_score")
                fi
                current_args+=(--latino "$next_has_latino" --marathon)
                continue
            fi
        fi
        break
    done

    cleanup
}

# Ayuda
if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    echo -e "${CYAN}${BOLD}Uso de 'serie' / 'pelis':${NC}"
    echo -e "  ${GREEN}serie${NC}                                 Menú principal interactivo"
    echo -e "  ${GREEN}serie voz${NC}                             Buscar hablando por el micrófono"
    echo -e "  ${GREEN}serie \"<nombre>\"${NC}                     Busca una serie o película"
    echo -e "  ${GREEN}serie \"<nombre>\" <temp> <cap>${NC}        Busca directo temporada y capítulo (ej. serie \"The Last of Us\" 1 2)"
    echo -e "  ${GREEN}serie \"<enlace_magnet>\"${NC}               Reproduce el magnet directamente"
    exit 0
fi

# Detectar si fue invocado como 'pelis' para priorizar películas en Cinemeta
if [[ "$0" == *pelis* ]]; then
    export MEDIA_PREF="movie"
fi

# Modo voz directa: serie voz / pelis voz
if [[ "$1" == "voz" || "$1" == "voice" || "$1" == "-v" ]]; then
    VOICE_QUERY=$("$VOICE_SCRIPT")
    if [ -n "$VOICE_QUERY" ]; then
        run_search_and_play "$VOICE_QUERY"
    fi
    exit 0
fi

# Modo audio latino (Web Scraping): serie latino <nombre> / pelis latino <nombre>
if [[ "$1" == "latino" || "$1" == "lat" || "$1" == "--latino" ]]; then
    shift
    exec latino "$@"
fi

# Modo búsqueda por texto: serie buscar <nombre> / pelis buscar <nombre>
if [[ "$1" == "buscar" || "$1" == "search" || "$1" == "-s" ]]; then
    shift
    run_search_and_play "$@"
    exit 0
fi

# Si pasaron un enlace magnet directo
if [[ "$1" == magnet:\?* ]]; then
    play_stream "$@"
    while [ -f /tmp/marathon_next.json ]; do
        next_ep=$(jq -r '.next_ep' /tmp/marathon_next.json 2>/dev/null)
        next_season=$(jq -r '.season' /tmp/marathon_next.json 2>/dev/null)
        next_title=$(jq -r '.title' /tmp/marathon_next.json 2>/dev/null)
        next_imdb=$(jq -r '.imdb_id // empty' /tmp/marathon_next.json 2>/dev/null)
        next_group=$(jq -r '.group // empty' /tmp/marathon_next.json 2>/dev/null)
        next_res=$(jq -r '.res // empty' /tmp/marathon_next.json 2>/dev/null)
        next_has_latino=$(jq -r '.has_latino // 0' /tmp/marathon_next.json 2>/dev/null)
        next_lang_score=$(jq -r '.lang_score // 0' /tmp/marathon_next.json 2>/dev/null)
        rm -f /tmp/marathon_next.json
        if [ -n "$next_ep" ] && [ "$next_ep" != "null" ]; then
            echo -e "\n${CYAN}${BOLD}╔══════════════════════════════════════════════════════════════╗${NC}"
            echo -e "${CYAN}${BOLD}║  :: MODO MARATÓN: Cargando Temporada ${next_season} Episodio ${next_ep}...  ║${NC}"
            echo -e "${CYAN}${BOLD}╚══════════════════════════════════════════════════════════════╝${NC}\n"
            export RESUME_START_TIME=0
            local m_args=()
            if [ -n "$next_imdb" ]; then m_args+=(--imdb "$next_imdb"); fi
            if [ -n "$next_title" ]; then m_args+=(--title "$next_title"); fi
            m_args+=("$next_season" "$next_ep")
            if [ -n "$next_group" ]; then m_args+=(--group "$next_group"); fi
            if [ -n "$next_res" ]; then m_args+=(--res "$next_res"); fi
            if [ -n "$next_lang_score" ]; then m_args+=(--lang-score "$next_lang_score"); fi
            m_args+=(--latino "$next_has_latino" --marathon)
            run_search_and_play "${m_args[@]}"
            break
        fi
    done
    exit 0
fi

# Si pasaron argumentos directos: serie "Breaking Bad" 1 1 o serie "Dune"
if [[ -n "$1" ]]; then
    run_search_and_play "$@"
    exit 0
fi

# Menú principal si solo escribieron "serie" o "pelis"
echo -e "${CYAN}${BOLD}╔══════════════════════════════════════════════════════════════╗${NC}"
echo -e "${CYAN}${BOLD}║   :: REPRODUCTOR DE SERIES Y PELÍCULAS (Netflix/HBO/etc)     ║${NC}"
echo -e "${CYAN}${BOLD}╚══════════════════════════════════════════════════════════════╝${NC}"
echo -e "  ${GREEN}[1]${NC} Buscar Serie o Película por texto"
echo -e "  ${CYAN}[2]${NC} Buscar por VOZ (habla por el micrófono)"
echo -e "  ${YELLOW}[3]${NC} Pegar enlace magnet directo"
echo -e "  ${YELLOW}[4]${NC} Continuar viendo serie o película en progreso"
echo -e "  ${PURPLE}[5]${NC} Buscar en AUDIO LATINO (Web Scraping - Sin Torrents)"
echo -e "  ${RED}[q]${NC} Salir\n"

read -p "Elige una opción [1]: " MENU_CHOICE

if [[ "$MENU_CHOICE" == "2" || "$MENU_CHOICE" == "v" || "$MENU_CHOICE" == "voz" ]]; then
    VOICE_QUERY=$("$VOICE_SCRIPT")
    if [ -n "$VOICE_QUERY" ]; then
        run_search_and_play "$VOICE_QUERY"
    fi
elif [[ "$MENU_CHOICE" == "3" ]]; then
    read -p "Pega el enlace magnet: " DIRECT_TARGET
    if [ -n "$DIRECT_TARGET" ]; then
        play_stream "$DIRECT_TARGET"
    fi
elif [[ "$MENU_CHOICE" == "4" || "$MENU_CHOICE" == "c" || "$MENU_CHOICE" == "continuar" ]]; then
    exec "$HOME/.local/bin/continuar"
elif [[ "$MENU_CHOICE" == "5" || "$MENU_CHOICE" == "latino" || "$MENU_CHOICE" == "lat" ]]; then
    exec latino
elif [[ "$MENU_CHOICE" == "q" || "$MENU_CHOICE" == "Q" ]]; then
    exit 0
else
    # Opción 1: Buscar por texto
    run_search_and_play
fi
