CYAN = "\033[0;36m"
GREEN = "\033[0;32m"
YELLOW = "\033[1;33m"
PURPLE = "\033[0;35m"
BLUE = "\033[0;34m"
RED = "\033[0;31m"
BOLD = "\033[1m"
NC = "\033[0m"

USER_AGENT = "Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:128.0) Gecko/20100101 Firefox/128.0"

def log(msg="", end="\n"):
    sys.stderr.write(f"{msg}{end}")
    sys.stderr.flush()

def normalize_title(t: str) -> str:
    if not t:
        return ""
    t = unicodedata.normalize("NFKD", t).encode("ASCII", "ignore").decode("utf-8")
    t = t.lower()
    t = re.sub(r"[^a-z0-9\s]", " ", t)
    return " ".join(t.split())

def is_title_match(title1: str, title2: str, threshold: float = 0.75) -> bool:
    norm1 = normalize_title(title1)
    norm2 = normalize_title(title2)
    if not norm1 or not norm2:
        return False
    if norm1 == norm2:
        return True
    if norm1 in norm2 or norm2 in norm1:
        shorter = norm1 if len(norm1) < len(norm2) else norm2
        longer = norm2 if len(norm1) < len(norm2) else norm1
        if len(shorter.split()) >= 2 or len(shorter) >= 6:
            return True
    ratio = difflib.SequenceMatcher(None, norm1, norm2).ratio()
    return ratio >= threshold

def select_with_fzf(items_text, prompt=":: Seleccionar: ", header=""):
    if not shutil.which("fzf") or not sys.stdin.isatty():
        return None, False
    try:
        cmd = [
            "fzf",
            "--ansi",
            "--height=45%",
            "--layout=reverse",
            "--border",
            f"--prompt={prompt}",
            "--cycle"
        ]
        if header:
            cmd.append(f"--header={header}")
        p = subprocess.Popen(
            cmd,
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            text=True
        )
        out, _ = p.communicate(input="\n".join(items_text))
        if p.returncode == 0 and out.strip():
            m = re.search(r"\[\s*(\d+)\s*\]", out)
            if m:
                return int(m.group(1)) - 1, True
        elif p.returncode in (1, 130):
            return None, True
    except Exception:
        pass
    return None, False

def solve_pow(challenge: str, difficulty: int, salt: str) -> str:
    prefix = "0" * difficulty
    nonce = 0
    while True:
        d = f"{challenge}{nonce}".encode("utf-8")
        h = hashlib.sha256(d).hexdigest()
        if h.startswith(prefix):
            return hashlib.sha256(f"{challenge}{nonce}{salt}".encode("utf-8")).hexdigest()
        nonce += 1

def decrypt_links_node(key_hex: str, enc_links: list) -> list:
    input_json = json.dumps({"key": key_hex, "links": enc_links})
    js_code = '''
    const crypto = require("crypto");
    const data = JSON.parse(process.argv[1]);
    const key = Buffer.from(data.key, "hex").subarray(0, 32);
    const results = [];
    for (const link of data.links) {
        try {
            const buf = Buffer.from(link, "base64");
            const iv = buf.subarray(0, 16);
            const ciphertext = buf.subarray(16);
            const decipher = crypto.createDecipheriv("aes-256-cbc", key, iv);
            let dec = decipher.update(ciphertext, undefined, "utf8");
            dec += decipher.final("utf8");
            results.push(dec);
        } catch(e) {
            results.push(null);
        }
    }
    console.log(JSON.stringify(results));
    '''
    p = subprocess.run(["node", "-e", js_code, input_json], capture_output=True, text=True)
    if p.returncode == 0 and p.stdout.strip():
        try:
            return json.loads(p.stdout)
        except Exception:
            return []
    return []

def unpack_js_node(packed_str: str) -> str:
    m = re.search(r"eval\((function\(p,a,c,k,e,d\)[\s\S]*?\.split\('\|'\)\))\)", packed_str)
    if not m:
        return ""
    js_func = m.group(1)
    js_code = f"console.log(({js_func}));"
    p = subprocess.run(["node", "-e", js_code], capture_output=True, text=True)
    return p.stdout if p.returncode == 0 else ""

def resolve_cyberlocker_stream(session, embed_url: str, custom_referer: str = ""):
    if not embed_url:
        return None, None

    candidates = []
    if embed_url.startswith("http"):
        candidates.append(embed_url)

    code = embed_url.rstrip("/").split("/")[-1]
    mirrors = [
        f"https://vidhidepro.com/v/{code}",
        f"https://streamwish.to/e/{code}",
        f"https://flaswish.com/e/{code}",
        f"https://filelions.to/v/{code}",
        f"https://smoothpre.com/v/{code}"
    ]
    for m in mirrors:
        if m not in candidates:
            candidates.append(m)

    ref = custom_referer if custom_referer else "https://flixlatam.com/"

    for cand in candidates:
        try:
            cand_host = urllib.parse.urlparse(cand).netloc
            cand_origin = f"https://{cand_host}"
            cand_ref = f"{cand_origin}/"
            headers = {
                "Referer": ref if ref else cand_ref,
                "User-Agent": USER_AGENT
            }
            r = session.get(cand, headers=headers, timeout=5)
            if r.status_code == 200:
                if "File is no longer available" in r.text or "expired or has been deleted" in r.text:
                    continue
                if "eval(function(p,a,c,k,e,d)" in r.text:
                    unpacked = unpack_js_node(r.text)
                    m3u8s = re.findall(r"https?://[^\s\"\'<>]+\.m3u8[^\s\"\'<>]*", unpacked)
                    if m3u8s:
                        master_url = m3u8s[0]
                        try:
                            r_m = session.get(
                                master_url,
                                headers={"Referer": cand_ref, "Origin": cand_origin, "User-Agent": USER_AGENT},
                                timeout=3.5
                            )
                            if r_m.status_code == 200:
                                if "#EXT-X-STREAM-INF" in r_m.text:
                                    base_m = master_url[:master_url.rfind("/") + 1]
                                    sub_lines = [l.strip() for l in r_m.text.splitlines() if l.strip() and not l.startswith("#")]
                                    if sub_lines:
                                        # Priorizar variante de menor ancho de banda para audio ultra rápido
                                        best_sub = sub_lines[0]
                                        sub_url = best_sub if best_sub.startswith("http") else base_m + best_sub
                                        try:
                                            r_sub = session.get(
                                                sub_url,
                                                headers={"Referer": cand_ref, "Origin": cand_origin, "User-Agent": USER_AGENT},
                                                timeout=3.0
                                            )
                                            if r_sub.status_code == 200 and ("#EXTINF" in r_sub.text or "#EXT-X-TARGETDURATION" in r_sub.text):
                                                return sub_url, cand_ref
                                        except Exception:
                                            pass
                                        if len(sub_lines) > 1:
                                            alt_sub = sub_lines[-1]
                                            alt_url = alt_sub if alt_sub.startswith("http") else base_m + alt_sub
                                            try:
                                                r_alt = session.get(
                                                    alt_url,
                                                    headers={"Referer": cand_ref, "Origin": cand_origin, "User-Agent": USER_AGENT},
                                                    timeout=3.0
                                                )
                                                if r_alt.status_code == 200 and ("#EXTINF" in r_alt.text or "#EXT-X-TARGETDURATION" in r_alt.text):
                                                    return alt_url, cand_ref
                                            except Exception:
                                                pass
                                elif "#EXTINF" in r_m.text or "#EXT-X-TARGETDURATION" in r_m.text:
                                    return master_url, cand_ref
                        except Exception:
                            pass

                direct_m3u8 = re.findall(r"https?://[^\s\"\'<>]+\.m3u8[^\s\"\'<>]*", r.text)
                if direct_m3u8:
                    d_url = direct_m3u8[0]
                    try:
                        r_d = session.get(
                            d_url,
                            headers={"Referer": cand_ref, "Origin": cand_origin, "User-Agent": USER_AGENT},
                            timeout=3.0
                        )
                        if r_d.status_code == 200 and ("#EXTINF" in r_d.text or "#EXT-X-TARGETDURATION" in r_d.text or "#EXT-X-STREAM-INF" in r_d.text):
                            return d_url, cand_ref
                    except Exception:
                        pass
        except Exception:
            continue

    return None, None

# ==========================================================
# 1. FLIXLATAM
# ==========================================================

def search_flixlatam(session, query: str):
    try:
        url = f"https://flixlatam.com/search?s={query}"
        r = session.get(url, timeout=7)
        if r.status_code != 200:
            return []
        soup = BeautifulSoup(r.text, "html.parser")
        items = soup.select("article.item")
        results = []
        for it in items:
            a = it.select_one(".data h3 a") or it.select_one(".poster a")
            if not a:
                continue
            title = a.text.strip()
            title = re.sub(r"^Ver\s+", "", title, flags=re.I)
            title = re.sub(r"\s+online$", "", title, flags=re.I).strip()
            href = a.get("href") or ""
            poster_img = it.select_one(".poster img")
            poster = poster_img.get("src") if poster_img else ""
            year_el = it.select_one(".data span")
            year = year_el.text.strip() if year_el else ""
            rating_el = it.select_one(".rating")
            rating = rating_el.text.strip() if rating_el else ""
            is_tv = "/serie/" in href or "/anime/" in href

            results.append({
                "title": title,
                "url": href,
                "poster": poster,
                "year": year,
                "rating": rating,
                "is_series": is_tv,
                "is_anime": "/anime/" in href,
                "provider": "flixlatam",
                "provider_label": "FLIX"
            })
        return results
    except Exception:
        return []

def get_series_episodes_flixlatam(session, series_url: str):
    try:
        r = session.get(series_url, timeout=8)
        if r.status_code != 200:
            return []
        soup = BeautifulSoup(r.text, "html.parser")
        ep_elements = soup.select("ul.episodios li")
        episodes = []
        for el in ep_elements:
            a = el.select_one(".episodiotitle a")
            if not a:
                continue
            ep_href = a.get("href") or ""
            if ep_href.startswith("/"):
                ep_href = "https://flixlatam.com" + ep_href
            ep_name = a.text.strip()
            num_el = el.select_one(".numerando")
            num_str = num_el.text.strip() if num_el else "1 - 1"
            s_num = 1
            e_num = 1
            m = re.search(r"(\d+)\s*-\s*(\d+)", num_str)
            if m:
                s_num = int(m.group(1))
                e_num = int(m.group(2))
            episodes.append({
                "name": ep_name,
                "url": ep_href,
                "season": s_num,
                "episode": e_num
            })
        return episodes
    except Exception:
        return []

def extract_stream_flixlatam(session, page_url: str):
    try:
        r = session.get(page_url, timeout=8)
        if r.status_code != 200:
            return None, None, None
        soup = BeautifulSoup(r.text, "html.parser")
        iframe = soup.select_one("div.play iframe") or soup.select_one("iframe")
        if not iframe:
            return None, None, None
        vid_src = iframe.get("src") or ""
        if vid_src.startswith("/"):
            vid_src = "https://flixlatam.com" + vid_src

        headers = {
            "Referer": page_url,
            "User-Agent": USER_AGENT,
            "Sec-Fetch-Dest": "iframe",
            "Sec-Fetch-Mode": "navigate",
            "Sec-Fetch-Site": "same-origin"
        }
        r2 = session.get(vid_src, headers=headers, timeout=8)
        if r2.status_code != 200:
            return None, None, None

        m_chal = re.search(r"const POW_CHALLENGE\s*=\s*'([^']+)'", r2.text)
        m_diff = re.search(r"const POW_DIFFICULTY\s*=\s*(\d+)", r2.text)
        m_salt = re.search(r"const POW_SALT\s*=\s*'([^']+)'", r2.text)
        m_data = re.search(r"let\s+dataLink\s*=\s*(\[[\s\S]*?\]);", r2.text)

        if not (m_chal and m_diff and m_salt and m_data):
            return None, None, None

        chal = m_chal.group(1)
        diff = int(m_diff.group(1))
        salt = m_salt.group(1)
        data_list = json.loads(m_data.group(1))

        key_hex = solve_pow(chal, diff, salt)

        def lang_priority(entry):
            lang = entry.get("video_language", "").upper()
            if "LAT" in lang:
                return 0
            if "ESP" in lang:
                return 1
            return 2

        data_list.sort(key=lang_priority)

        for entry in data_list:
            lang = entry.get("video_language", "LAT")
            all_embeds = entry.get("sortedEmbeds", []) + entry.get("downloadEmbeds", [])
            enc_links = [item["link"] for item in all_embeds if isinstance(item, dict) and "link" in item]
            if not enc_links:
                continue

            decrypted_urls = decrypt_links_node(key_hex, enc_links)
            for dec_url in decrypted_urls:
                if not dec_url:
                    continue
                stream_url, ref = resolve_cyberlocker_stream(session, dec_url, custom_referer="https://flixlatam.com/")
                if stream_url:
                    return stream_url, ref, lang

        return None, None, None
    except Exception:
        return None, None, None

# ==========================================================
# 2. CUEVANA 3 (cuevana3.eu)
# ==========================================================

def search_cuevana3(session, query: str):
    try:
        url = f"https://cuevana3.eu/search?q={query}"
        r = session.get(url, timeout=7)
        if r.status_code != 200:
            return []
        soup = BeautifulSoup(r.text, "html.parser")
        sc = soup.find("script", id="__NEXT_DATA__")
        if not sc:
            return []
        data = json.loads(sc.text)
        movies = data["props"]["pageProps"].get("movies", [])
        results = []
        for m in movies:
            name = m.get("titles", {}).get("name") or m.get("title") or ""
            if not name:
                continue
            poster = m.get("images", {}).get("poster", "")
            url_slug = m.get("url", {}).get("slug", "")
            is_series = "series/" in url_slug
            slug_name = m.get("slug", {}).get("name", "")
            if not slug_name:
                continue
            full_url = f"https://cuevana3.eu/ver-serie/{slug_name}" if is_series else f"https://cuevana3.eu/ver-pelicula/{slug_name}"
            
            release = m.get("releaseDate", "")
            year = release[:4] if release and len(release) >= 4 else ""
            rate = m.get("rate", {}).get("average", "")
            rating_str = f"{rate:.1f}" if isinstance(rate, (int, float)) and rate > 0 else ""

            results.append({
                "title": name,
                "url": full_url,
                "poster": poster,
                "year": year,
                "rating": rating_str,
                "is_series": is_series,
                "is_anime": False,
                "provider": "cuevana3",
                "provider_label": "CUEV3"
            })
        return results
    except Exception:
        return []

def get_series_episodes_cuevana3(session, series_url: str):
    try:
        r = session.get(series_url, timeout=8)
        if r.status_code != 200:
            return []
        soup = BeautifulSoup(r.text, "html.parser")
        sc = soup.find("script", id="__NEXT_DATA__")
        if not sc:
            return []
        data = json.loads(sc.text)
        this_serie = data["props"]["pageProps"].get("thisSerie", {})
        seasons = this_serie.get("seasons", [])
        episodes = []
        for s_idx, season in enumerate(seasons):
            s_num = season.get("number") or (s_idx + 1)
            eps = season.get("episodes", [])
            for ep in eps:
                slug_obj = ep.get("slug", {})
                s_val = int(slug_obj.get("season") or s_num or 1)
                e_val = int(slug_obj.get("episode") or ep.get("number") or 1)
                name_val = slug_obj.get("name")
                if not name_val:
                    continue
                ep_url = f"https://cuevana3.eu/episodio/{name_val}-temporada-{s_val}-episodio-{e_val}"
                ep_title = ep.get("title") or f"Episodio {e_val}"
                episodes.append({
                    "name": ep_title,
                    "url": ep_url,
                    "season": s_val,
                    "episode": e_val
                })
        return episodes
    except Exception:
        return []

def extract_stream_cuevana3(session, page_url: str):
    try:
        r = session.get(page_url, timeout=8)
        if r.status_code != 200:
            return None, None, None
        soup = BeautifulSoup(r.text, "html.parser")
        sc = soup.find("script", id="__NEXT_DATA__")
        if not sc:
            return None, None, None
        data = json.loads(sc.text)
        page_props = data["props"]["pageProps"]
        target = page_props.get("thisMovie") or page_props.get("episode")
        if not target:
            return None, None, None
        videos = target.get("videos", {})

        # Probar en orden de prioridad latino -> castellano -> subtitulado / inglés
        for lang_key in ["latino", "spanish", "english"]:
            v_list = videos.get(lang_key, [])
            for v in v_list:
                p_url = v.get("result")
                if not p_url:
                    continue
                try:
                    r_p = session.get(p_url, headers={"Referer": "https://cuevana3.eu/"}, timeout=5)
                    m = re.search(r"var url\s*=\s*'([^']+)'", r_p.text)
                    if m:
                        host_url = m.group(1)
                        st_url, ref = resolve_cyberlocker_stream(session, host_url, custom_referer="https://cuevana3.eu/")
                        if st_url:
                            return st_url, ref, lang_key.upper()
                except Exception:
                    continue
        return None, None, None
    except Exception:
        return None, None, None

# ==========================================================
# 3. JKANIME (jkanime.net)
# ==========================================================

def search_jkanime(session, query: str):
    try:
        url = f"https://jkanime.net/buscar/{query}/"
        r = session.get(url, timeout=7)
        if r.status_code != 200:
            return []
        soup = BeautifulSoup(r.text, "html.parser")
        results = []
        seen = set()
        for item in soup.select("div.anime__item"):
            a = item.find("a")
            if not a:
                continue
            href = a.get("href") or ""
            t_el = item.select_one("h5 a") or item.select_one(".anime__item__text h5") or a
            t = t_el.text.strip() if t_el else ""
            if href and t and href not in seen:
                seen.add(href)
                img = a.find("img")
                poster = img.get("src") if img else ""
                results.append({
                    "title": t,
                    "url": href,
                    "poster": poster,
                    "year": "",
                    "rating": "",
                    "is_series": True,
                    "is_anime": True,
                    "provider": "jkanime",
                    "provider_label": "JKAN"
                })
        return results
    except Exception:
        return []

def get_series_episodes_jkanime(session, anime_url: str):
    try:
        r = session.get(anime_url, timeout=8)
        if r.status_code != 200:
            return []
        clean_url = anime_url.rstrip("/")
        slug = clean_url.split("/")[-1]

        total_eps = 0
        m_last = re.search(r"Último episodio.*?href=[\'\"][^\'\"]*/(\d+)/", r.text, re.DOTALL)
        if m_last:
            total_eps = int(m_last.group(1))
        else:
            m = re.search(r"Episodios:\s*</span>\s*(\d+)", r.text)
            if not m:
                m = re.search(r"Episodios:\s*(\d+)", r.text)
            if m:
                total_eps = int(m.group(1))

        if total_eps == 0:
            total_eps = 1

        episodes = []
        for ep_num in range(1, total_eps + 1):
            ep_url = f"https://jkanime.net/{slug}/{ep_num}/"
            episodes.append({
                "name": f"Capítulo {ep_num}",
                "url": ep_url,
                "season": 1,
                "episode": ep_num
            })
        return episodes
    except Exception:
        return []

def extract_stream_jkanime(session, ep_url: str):
    try:
        r = session.get(ep_url, timeout=8)
        if r.status_code != 200:
            return None, None, None
        soup = BeautifulSoup(r.text, "html.parser")
        scripts = [sc.text for sc in soup.find_all("script") if "video[" in sc.text]
        iframes = []
        for sc in scripts:
            iframes.extend(re.findall(r"src=[\x27\x22](https://jkanime\.net/jkplayer/[^\x27\x22]+)[\x27\x22]", sc))

        for ifr in iframes:
            try:
                r_ifr = session.get(ifr, headers={"Referer": ep_url}, timeout=6)
                m3u8s = re.findall(r"url:\s*[\x27\x22]([^\x27\x22]+\.m3u8[^\x27\x22]*)[\x27\x22]", r_ifr.text)
                if m3u8s:
                    return m3u8s[0], "https://jkanime.net/", "SUB/LAT"
            except Exception:
                continue
        return None, None, None
    except Exception:
        return None, None, None

# ==========================================================
# 4. BÚSQUEDA CONCURRENTE & AGREGACIÓN
# ==========================================================

def search_all_sources(session, query: str):
    with ThreadPoolExecutor(max_workers=3) as ex:
        f_flix = ex.submit(search_flixlatam, session, query)
        f_cuev = ex.submit(search_cuevana3, session, query)
        f_jkan = ex.submit(search_jkanime, session, query)

        res_flix = []
        res_cuev = []
        res_jkan = []

        try:
            res_flix = f_flix.result(timeout=8)
        except Exception:
            pass
        try:
            res_cuev = f_cuev.result(timeout=8)
        except Exception:
            pass
        try:
            res_jkan = f_jkan.result(timeout=8)
        except Exception:
            pass

    combined = []
    combined.extend(res_flix)
    combined.extend(res_cuev)
    combined.extend(res_jkan)

    q_norm = query.strip().lower()
    def rank_score(item):
        t = item["title"].lower()
        if t == q_norm:
            score = 0
        elif t.startswith(q_norm):
            score = 1
        elif q_norm in t:
            score = 2
        else:
            score = 3
        prov_weight = 0 if item["provider"] == "flixlatam" else (1 if item["provider"] == "cuevana3" else 2)
        return (score, prov_weight)

    combined.sort(key=rank_score)
    return combined

def get_episodes_for_item(session, item: dict):
    prov = item.get("provider")
    url = item.get("url", "")
    if prov == "flixlatam":
        return get_series_episodes_flixlatam(session, url)
    elif prov == "cuevana3":
        return get_series_episodes_cuevana3(session, url)
    elif prov == "jkanime":
        return get_series_episodes_jkanime(session, url)
    return []

def extract_stream_direct(session, provider: str, page_url: str):
    if provider == "flixlatam":
        return extract_stream_flixlatam(session, page_url)
    elif provider == "cuevana3":
        return extract_stream_cuevana3(session, page_url)
    elif provider == "jkanime":
        return extract_stream_jkanime(session, page_url)
    return None, None, None

def extract_stream_with_fallback(session, chosen_item: dict, chosen_ep_info: dict, all_results: list, user_query: str = ""):
    primary_prov = chosen_item.get("provider", "flixlatam")
    primary_label = chosen_item.get("provider_label", "FLIX")
    is_series = chosen_item.get("is_series", False)
    title = chosen_item.get("title", "")
    target_season = chosen_ep_info.get("season", 1) if chosen_ep_info else 1
    target_ep = chosen_ep_info.get("episode", 1) if chosen_ep_info else 1
    target_url = chosen_ep_info.get("url") if chosen_ep_info else chosen_item.get("url")

    # Intento 1: Proveedor seleccionado
    st_url, ref, lang = extract_stream_direct(session, primary_prov, target_url)
    if st_url:
        return st_url, ref, f"{lang} ({primary_label})" if f"({primary_label})" not in str(lang) else lang

    # Si falló, intentar fallback automático
    log(f"\n{YELLOW}:: [AVISO] Servidor no respondió en {primary_label}.{NC}")
    log(f"{CYAN}:: Activando respaldo automático en servidores alternativos...{NC}")

    # Fallback order
    fb_providers = []
    if primary_prov == "flixlatam":
        fb_providers = ["cuevana3", "jkanime"]
    elif primary_prov == "cuevana3":
        fb_providers = ["flixlatam", "jkanime"]
    else:
        fb_providers = ["flixlatam", "cuevana3"]

    for fb_prov in fb_providers:
        fb_label = "CUEV3" if fb_prov == "cuevana3" else ("FLIX" if fb_prov == "flixlatam" else "JKAN")
        
        # 1. Buscar en all_results con validación estricta de título
        matching_fb = [
            it for it in all_results
            if it.get("provider") == fb_prov 
            and it.get("is_series", False) == is_series 
            and (is_title_match(title, it.get("title", "")) or (user_query and is_title_match(user_query, it.get("title", ""))))
        ]

        # 2. Si no estaba en all_results con título válido, buscar en vivo en el proveedor alternativo
        if not matching_fb:
            candidates = []
            if fb_prov == "cuevana3":
                candidates = search_cuevana3(session, title)
                if not candidates and user_query and user_query != title:
                    candidates = search_cuevana3(session, user_query)
            elif fb_prov == "flixlatam":
                candidates = search_flixlatam(session, title)
                if not candidates and user_query and user_query != title:
                    candidates = search_flixlatam(session, user_query)
            elif fb_prov == "jkanime":
                candidates = search_jkanime(session, title)
                if not candidates and user_query and user_query != title:
                    candidates = search_jkanime(session, user_query)

            # Filtrar candidatos estrictamente por tipo y título (¡NUNCA FORZAR COINCIDENCIAS FALSAS!)
            for cand in candidates:
                if cand.get("is_series", False) == is_series:
                    if is_title_match(title, cand.get("title", "")) or (user_query and is_title_match(user_query, cand.get("title", ""))):
                        matching_fb.append(cand)

        # Si no hay ninguna coincidencia real, NO forzar y pasar al siguiente proveedor
        if not matching_fb:
            log(f"{YELLOW}:: No se encontró versión equivalente para '{title}' en {fb_label}.{NC}")
            continue

        fb_media = matching_fb[0]
        log(f"{BLUE}:: Comprobando alternativa verificada en {fb_label}: '{fb_media['title']}'...{NC}")

        if is_series:
            fb_eps = get_episodes_for_item(session, fb_media)
            chosen_fb_ep = None
            for ep in fb_eps:
                if ep["season"] == target_season and ep["episode"] == target_ep:
                    chosen_fb_ep = ep
                    break
            if not chosen_fb_ep:
                # Intentar coincidencia sólo por número de capítulo
                for ep in fb_eps:
                    if ep["episode"] == target_ep:
                        chosen_fb_ep = ep
                        break

            if chosen_fb_ep:
                fb_st, fb_ref, fb_lang = extract_stream_direct(session, fb_prov, chosen_fb_ep["url"])
                if fb_st:
                    log(f"{GREEN}:: ¡Respaldo exitoso en {fb_label}! Transmitiendo capítulo {target_ep}.{NC}")
                    return fb_st, fb_ref, f"{fb_lang} ({fb_label})"
                else:
                    log(f"{YELLOW}:: El capítulo {target_ep} tampoco respondió en {fb_label}.{NC}")
            else:
                log(f"{YELLOW}:: El capítulo {target_ep} no existe en {fb_label}.{NC}")
        else:
            # Película
            fb_st, fb_ref, fb_lang = extract_stream_direct(session, fb_prov, fb_media["url"])
            if fb_st:
                log(f"{GREEN}:: ¡Respaldo exitoso en {fb_label}! Transmitiendo película.{NC}")
                return fb_st, fb_ref, f"{fb_lang} ({fb_label})"
            else:
                log(f"{YELLOW}:: La película tampoco respondió en {fb_label}.{NC}")

    return None, None, None

# ==========================================================
# 5. ENTRY POINT PRINCIPAL
# ==========================================================

def main():
    query = ""
    target_season = None
    target_episode = None

    args = sys.argv[1:]
    if args:
        if len(args) >= 3 and args[-2].isdigit() and args[-1].isdigit():
            target_season = int(args[-2])
            target_episode = int(args[-1])
            query = " ".join(args[:-2])
        elif len(args) >= 2 and args[-1].isdigit():
            target_episode = int(args[-1])
            query = " ".join(args[:-1])
        else:
            query = " ".join(args)

    if not query.strip():
        log(f"{CYAN}{BOLD}╔══════════════════════════════════════════════════════════════╗{NC}")
        log(f"{CYAN}{BOLD}║   :: MOKI - BÚSQUEDA WEB MULTI-SERVIDOR (Sin Torrents)       ║{NC}")
        log(f"{CYAN}{BOLD}║   :: Flixlatam • Cuevana 3 • JKAnime • Respaldo Automático   ║{NC}")
        log(f"{CYAN}{BOLD}╚══════════════════════════════════════════════════════════════╝{NC}")
        log(f"{YELLOW}Ingresa el nombre de la película, serie o anime a buscar: {NC}", end="")
        try:
            query = sys.stdin.readline().strip()
        except KeyboardInterrupt:
            sys.exit(0)

    if not query.strip():
        sys.exit(0)

    log(f"\n{GREEN}:: Buscando en catálogo multi-servidor '{query}'...{NC}")
    session = requests.Session(impersonate="chrome120")
    results = search_all_sources(session, query)

    if not results:
        log(f"{RED}:: No se encontraron resultados en los servidores para '{query}'.{NC}")
        sys.exit(1)

    fzf_lines = []
    for i, r in enumerate(results, 1):
        if r["provider_label"] == "FLIX":
            prov_badge = f"{GREEN}[FLIX] {NC}"
        elif r["provider_label"] == "CUEV3":
            prov_badge = f"{BLUE}[CUEV3]{NC}"
        else:
            prov_badge = f"{PURPLE}[JKAN] {NC}"

        if r.get("is_anime"):
            type_tag = f"{YELLOW}[ANIME]{NC}"
        elif r.get("is_series"):
            type_tag = f"{PURPLE}[SERIE]{NC}"
        else:
            type_tag = f"{CYAN}[PELI] {NC}"

        year_str = f"({r['year']})" if r.get("year") else ""
        rating_str = f"★ {r['rating']}" if r.get("rating") else ""
        line = f"{CYAN}[{i:2d}]{NC} {prov_badge} {type_tag} {BOLD}{r['title']}{NC}  {YELLOW}{year_str}{NC} {GREEN}{rating_str}{NC}"
        fzf_lines.append(line)

    chosen = None
    # Si viene con temporada o capítulo específico vía CLI y coincide un resultado
    if (target_season is not None or target_episode is not None) and len(results) > 0:
        # 1. Priorizar coincidencia estricta que sea serie
        for r in results:
            if r.get("is_series") and is_title_match(query, r["title"]):
                chosen = r
                break
        if not chosen:
            # 2. Coincidencia difusa con ratio aceptable (>= 0.40)
            best_r = None
            best_ratio = 0.0
            for r in results:
                if r.get("is_series"):
                    ratio = difflib.SequenceMatcher(None, normalize_title(query), normalize_title(r["title"])).ratio()
                    if ratio > best_ratio:
                        best_ratio = ratio
                        best_r = r
            if best_r and best_ratio >= 0.40:
                chosen = best_r
        # Si no hubo coincidencia clara, no forzar una serie aleatoria: chosen quedará None y abrirá el menú interactivo para que el usuario elija.

    if not chosen:
        c_idx, used_fzf = select_with_fzf(
            fzf_lines,
            prompt="🔎 Seleccionar: ",
            header=f"Resultados para '{query}' | ↑↓ Moverse | Enter = Seleccionar | Esc = Salir"
        )

        if used_fzf:
            if c_idx is None:
                sys.exit(0)
            chosen = results[c_idx]
        else:
            log(f"\n{GREEN}Resultados encontrados:{NC}")
            for l in fzf_lines:
                log(f"  {l}")
            while True:
                log(f"\n{YELLOW}Elige una opción (1-{len(results)}) o 'q' para salir: {NC}", end="")
                ans = sys.stdin.readline().strip()
                if ans.lower() in ("q", "quit", "exit", ""):
                    sys.exit(0)
                if ans.isdigit() and 1 <= int(ans) <= len(results):
                    chosen = results[int(ans) - 1]
                    break
                log(f"{RED}Opción inválida.{NC}")

    if not chosen:
        sys.exit(0)

    media_title = chosen["title"]
    media_poster = chosen.get("poster", "")
    is_series = chosen.get("is_series", False)
    selected_season = 1
    selected_ep_num = 1
    ep_name = "Película"
    chosen_ep_info = None

    if is_series:
        log(f"\n{GREEN}:: Cargando lista de episodios desde [{chosen['provider_label']}] para '{media_title}'...{NC}")
        episodes = get_episodes_for_item(session, chosen)
        if not episodes:
            log(f"{RED}:: No se pudieron obtener los episodios en {chosen['provider_label']}.{NC}")
            sys.exit(1)

        if target_season is not None and target_episode is not None:
            for ep in episodes:
                if ep["season"] == target_season and ep["episode"] == target_episode:
                    chosen_ep_info = ep
                    break
        elif target_episode is not None:
            for ep in episodes:
                if ep["episode"] == target_episode:
                    chosen_ep_info = ep
                    break

        if not chosen_ep_info:
            ep_lines = []
            for i, ep in enumerate(episodes, 1):
                ep_tag = f"T{ep['season']:02d}E{ep['episode']:02d}"
                ep_lines.append(f"{CYAN}[{i:3d}]{NC} {YELLOW}{ep_tag}{NC} • {BOLD}{ep['name']}{NC}")

            c_ep_idx, used_fzf_ep = select_with_fzf(
                ep_lines,
                prompt="🔎 Seleccionar capítulo: ",
                header=f"{media_title} [{chosen['provider_label']}] • Total: {len(episodes)} | ↑↓ Moverse | Enter = Ver"
            )

            if used_fzf_ep:
                if c_ep_idx is None:
                    sys.exit(0)
                chosen_ep_info = episodes[c_ep_idx]
            else:
                for l in ep_lines:
                    log(f"  {l}")
                while True:
                    log(f"\n{YELLOW}Elige un capítulo (1-{len(episodes)}) o 'q' para salir: {NC}", end="")
                    ans = sys.stdin.readline().strip()
                    if ans.lower() in ("q", "quit", "exit", ""):
                        sys.exit(0)
                    if ans.isdigit() and 1 <= int(ans) <= len(episodes):
                        chosen_ep_info = episodes[int(ans) - 1]
                        break
                    log(f"{RED}Opción inválida.{NC}")

        if chosen_ep_info:
            selected_season = chosen_ep_info["season"]
            selected_ep_num = chosen_ep_info["episode"]
            ep_name = f"Temporada {selected_season} • Episodio {selected_ep_num} ({chosen_ep_info['name']})"

    log(f"\n{CYAN}:: Extrayendo stream para {BOLD}{media_title}{NC}...")
    stream_url, referer, lang = extract_stream_with_fallback(session, chosen, chosen_ep_info, results, user_query=query)

    if not stream_url:
        log(f"{RED}:: No se pudo resolver un stream activo en ninguno de los servidores disponibles.{NC}")
        sys.exit(1)

    log(f"{GREEN}:: Stream verificado con éxito [{lang}]. Iniciando reproductor mpv...{NC}\n")

    print(f"STREAM_URL:{stream_url}")
    print(f"REFERER:{referer}")
    print(f"TITLE:{media_title}")
    print(f"TYPE:{'series' if is_series else 'movie'}")
    print(f"SEASON:{selected_season}")
    print(f"EPISODE_NUM:{selected_ep_num}")
    print(f"EPISODE:{ep_name}")
    if media_poster:
        print(f"POSTER:{media_poster}")
    sys.stdout.flush()

if __name__ == "__main__":
    main()
