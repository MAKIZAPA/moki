# ==========================================
# MOKI - .gitignore
# ==========================================

AGENTS.md


# Archivos de respaldo y configuración local
*.moki_backup
*.bak
*.old

# Archivos temporales y cachés de streaming
*.tmp
*.torrent
/tmp/
cache/

# Datos locales e historial de reproducción
history.json
*.log

# Archivos compilados de Python (si se usan helpers)
__pycache__/
*.py[cod]
*$py.class
*.env
.venv/
env/

# Dependencias Node/NPM locales
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editores y entornos de desarrollo
.vscode/
.idea/
*.swp
*.swo
*~

# Archivos de sistema operativo
.DS_Store
Thumbs.db
